# Oculus v4 Configuration File
# Copy to ~/.config/oculus/config.yaml

# General settings
threads: 50
timeout: 300
rate_limit: 150
retry_count: 2
retry_delay: 5
# Default timeout used by generic shell-invocations when a module doesn't pass its own timeout
default_timeout: 300

# SQLMap defaults (per-scan settings). You can override these per-scan via the web UI or API.
sqlmap:
  level: 5       # SQLMap "level" (1-5) — aggression of tests
  risk: 3        # SQLMap "risk" (1-3) — riskier payloads at higher values
  threads: 10    # SQLMap internal worker threads (maximum allowed by SQLMap is 10)

# Ghauri — second SQLi engine (SQLi Scan module: SQLMap + Ghauri on merged targets)
ghauri:
  enabled: true
  parallel: true     # true = Ghauri while SQLMap runs (~400MB–1.5GB peak combined); false = one after the other
  level: 3
  risk: 2
  threads: 5
  max_targets: 150   # Cap bulk list (Ghauri can be slow per URL on high level/risk)
  delay: 0
  timeout: 30
  techniques: ""     # Optional e.g. BEUSTQ; empty = Ghauri default

parallel: true        # Run independent tools concurrently
auto_confirm: false   # Skip confirmation prompts (useful for automation)
jitter: false         # Add random delays between tool calls for stealth

# Wordlist paths
wordlists:
  dns: /usr/share/wordlists/seclists/Discovery/DNS/subdomains-top1million-110000.txt
  dirs: /usr/share/wordlists/seclists/Discovery/Web-Content/common.txt
  dirs_fallback: /usr/share/wordlists/dirb/common.txt
  resolvers: /opt/recontools/massdns/resolvers.txt

# API Keys (optional — enables passive recon and 100x subdomain yield)
api_keys:
  shodan: ""            # Active Shodan API Key (Module 28)
  github: ""            # GitHub Classic/Fine-grained PAT with repo read scope (Module 26)
  chaos: ""             # ProjectDiscovery Chaos API Key (Subfinder / DNS resolution)
  virustotal: ""        # VirusTotal Passive API Key (Subfinder)
  securitytrails: ""    # SecurityTrails Enterprise/Free API Key (Subfinder - highly recommended)
  censys_id: ""         # Censys Search API ID (Subfinder)
  censys_secret: ""     # Censys Search API Secret (Subfinder)
  binaryedge: ""        # BinaryEdge API Key (Subfinder)
  intelx: ""            # IntelligenceX API Key (Subfinder)

# Nuclei configuration
nuclei:
  severity: low,medium,high,critical
  rate_limit: 150
  concurrency: 25
  templates: ""   # Custom template path (leave empty for defaults)

# Naabu port scanner
naabu:
  ports: "1-65535"
  rate: 2000

# Nmap full-port scan timeout scaling
nmap:
  full_port_timeout_base: 3600       # Minimum budget: 1 hour
  full_port_timeout_per_host: 900    # Add 15 minutes per target
  full_port_timeout_max: 43200       # Hard cap: 12 hours

# FFUF directory fuzzing
ffuf:
  extensions: php,html,js,json,txt,bak,old
  status_filter: "200,204,301,302,307,401,403"
  recursion_depth: 2
  max_hosts: 25        # Maximum alive hosts to fuzz

# ntfy push notifications
ntfy:
  enabled: true
  # Use either a full topic URL or server + topic.
  url: ""
  server: https://ntfy.sh
  topic: "oculus"
  token: ""
  username: ""
  password: ""
  priority: default
  tags: rocket
  send_scan_start: true
  send_scan_complete: true
  send_module_start: true
  send_module_complete: true
  send_findings: true
  send_errors: true
  send_skips: true
  timeout: 8
  dedupe_window: 20

# Jaeles configuration
jaeles:
  concurrency: 20
  signatures: ""       # Custom signature path (leave empty for default ~/.jaeles)
  max_hosts: 100       # Maximum hosts to scan (default 100)

# Nikto configuration
nikto:
  tuning: "1234"       # Nikto tuning options: 1-9, a-x
  timeout: 600         # Scan timeout in seconds per host
  max_hosts: 25        # Maximum hosts to scan

# WhatWaf configuration
whatwaf:
  max_hosts: 100       # Maximum alive hosts to scan with WhatWaf

# InternetDB configuration
internetdb:
  max_ips: 1000        # Maximum IPs to query

# CRLFuzz configuration
crlfuzz:
  concurrency: 25

# Tplmap configuration
tplmap:
  max_urls: 300        # Maximum SSTI candidates to test

# nomore403 configuration
nomore403:
  max_urls: 300        # Maximum forbidden/admin URLs to test
  fallback_hosts: 25   # Alive hosts used for fallback admin-path probes

# PureDNS configuration
puredns:
  threads: 100
  wildcard_batch: 1000000
